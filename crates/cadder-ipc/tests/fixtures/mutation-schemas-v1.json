{
  "heartbeat-entrypoint-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Renews the lease for a live entrypoint registration.",
    "properties": {
      "registrationId": { "type": "string" },
      "shimSessionNonce": { "type": "string" }
    },
    "required": ["registrationId", "shimSessionNonce"],
    "title": "HeartbeatEntrypointPayload",
    "type": "object"
  },
  "register-entrypoint-request": {
    "$defs": {
      "DomainNamePayload": {
        "additionalProperties": false,
        "description": "Closed raw and canonical domain name supplied during registration.",
        "properties": {
          "canonical": { "type": "string" },
          "raw": { "type": "string" }
        },
        "required": ["raw", "canonical"],
        "type": "object"
      },
      "EntrypointInstancePayload": {
        "additionalProperties": false,
        "description": "Closed identity supplied for one live shim instance.",
        "properties": {
          "instanceId": { "type": "string" },
          "shimSessionNonce": { "type": "string" },
          "startedAtUtc": { "format": "date-time", "type": "string" }
        },
        "required": ["instanceId", "startedAtUtc", "shimSessionNonce"],
        "type": "object"
      },
      "EntrypointRegistrationPayload": {
        "additionalProperties": false,
        "description": "Deliberately stable registration input, separate from additive runtime snapshots.",
        "properties": {
          "activationState": { "$ref": "#/$defs/RegistrationActivationState" },
          "createdAtUtc": { "format": "date-time", "type": "string" },
          "entrypointInstance": { "$ref": "#/$defs/EntrypointInstancePayload" },
          "lastHeartbeatUtc": { "format": "date-time", "type": "string" },
          "logStream": { "$ref": "#/$defs/RegistrationLogStreamPayload" },
          "ownerProcess": { "$ref": "#/$defs/OwnerProcessPayload" },
          "registeredDomains": {
            "items": { "$ref": "#/$defs/RegisteredDomainPayload" },
            "type": "array"
          },
          "registrationId": { "type": "string" },
          "shimRun": {
            "anyOf": [
              { "$ref": "#/$defs/ShimRunPayload" },
              { "type": "null" }
            ]
          },
          "sourceConfigPath": { "$ref": "#/$defs/SourcePathPayload" },
          "sourceWorkingDirectory": { "$ref": "#/$defs/SourcePathPayload" }
        },
        "required": [
          "registrationId",
          "entrypointInstance",
          "sourceWorkingDirectory",
          "sourceConfigPath",
          "registeredDomains",
          "activationState",
          "ownerProcess",
          "logStream",
          "createdAtUtc",
          "lastHeartbeatUtc"
        ],
        "type": "object"
      },
      "OwnerProcessPayload": {
        "additionalProperties": false,
        "description": "Closed owner-process identity supplied by a shim registration.",
        "properties": {
          "executablePath": { "type": ["string", "null"] },
          "processId": { "format": "uint32", "minimum": 0, "type": "integer" },
          "processStartTimeUtc": { "format": "date-time", "type": "string" },
          "shimSessionNonce": { "type": "string" }
        },
        "required": ["processId", "processStartTimeUtc", "shimSessionNonce"],
        "type": "object"
      },
      "RegisteredDomainPayload": {
        "additionalProperties": false,
        "description": "Closed domain entry supplied by a shim registration.",
        "properties": {
          "activationState": { "$ref": "#/$defs/RegistrationActivationState" },
          "logStream": { "$ref": "#/$defs/RegistrationLogStreamPayload" },
          "name": { "$ref": "#/$defs/DomainNamePayload" },
          "upstream": { "type": ["string", "null"] }
        },
        "required": ["name", "activationState", "logStream"],
        "type": "object"
      },
      "RegistrationActivationState": {
        "description": "Activation values accepted by the immutable V1 registration input contract.",
        "enum": ["unknown", "registered", "activating", "active", "inactive", "faulted"],
        "type": "string"
      },
      "RegistrationLogStreamPayload": {
        "additionalProperties": false,
        "description": "Closed log-stream identity supplied by a shim registration.",
        "properties": {
          "channel": { "type": "string" },
          "domainKey": { "type": ["string", "null"] },
          "streamId": { "type": "string" }
        },
        "required": ["streamId", "channel"],
        "type": "object"
      },
      "ShimRunPayload": {
        "additionalProperties": false,
        "description": "Closed command metadata supplied by a shim registration.",
        "properties": {
          "adapter": { "type": ["string", "null"] },
          "commandLine": { "type": "string" },
          "rawArguments": { "items": { "type": "string" }, "type": "array" }
        },
        "required": ["rawArguments", "commandLine"],
        "type": "object"
      },
      "SourcePathPayload": {
        "additionalProperties": false,
        "description": "Closed source-path representation supplied during registration.",
        "properties": {
          "canonical": { "type": ["string", "null"] },
          "raw": { "type": "string" }
        },
        "required": ["raw"],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Registers one shim-owned entrypoint after the request envelope is authorized.",
    "properties": {
      "registration": { "$ref": "#/$defs/EntrypointRegistrationPayload" }
    },
    "required": ["registration"],
    "title": "RegisterEntrypointPayload",
    "type": "object"
  },
  "set-autostart-request": {
    "$defs": {
      "AutostartModePayload": {
        "description": "Autostart values accepted by the immutable V1 mutation input contract.",
        "enum": ["disabled", "daemon"],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Selects the desired per-user daemon autostart mode.",
    "properties": {
      "mode": { "$ref": "#/$defs/AutostartModePayload" }
    },
    "required": ["mode"],
    "title": "SetAutostartPayload",
    "type": "object"
  },
  "set-domain-enabled-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Changes the desired activation state of one registered domain.",
    "properties": {
      "domainKey": { "type": "string" },
      "enabled": { "type": "boolean" },
      "registrationId": { "type": "string" }
    },
    "required": ["registrationId", "domainKey", "enabled"],
    "title": "SetDomainEnabledPayload",
    "type": "object"
  },
  "set-entrypoint-enabled-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Changes the desired activation state of one entrypoint.",
    "properties": {
      "enabled": { "type": "boolean" },
      "registrationId": { "type": "string" },
      "shimSessionNonce": { "type": ["string", "null"] }
    },
    "required": ["registrationId", "enabled"],
    "title": "SetEntrypointEnabledPayload",
    "type": "object"
  },
  "set-iis-handoff-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Applies or restores one IIS binding handoff.",
    "properties": {
      "bindingId": { "type": "string" },
      "enabled": { "type": "boolean" },
      "routeHost": { "type": ["string", "null"] }
    },
    "required": ["bindingId", "enabled"],
    "title": "SetIisHandoffPayload",
    "type": "object"
  },
  "shutdown-daemon-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Requests a coordinated daemon shutdown without carrying duplicate correlation data.",
    "title": "ShutdownDaemonPayload",
    "type": "object"
  },
  "unregister-entrypoint-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Releases a live entrypoint registration owned by the matching shim session.",
    "properties": {
      "registrationId": { "type": "string" },
      "shimSessionNonce": { "type": "string" }
    },
    "required": ["registrationId", "shimSessionNonce"],
    "title": "UnregisterEntrypointPayload",
    "type": "object"
  }
}
